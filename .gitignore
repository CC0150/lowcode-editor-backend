# 1. 依赖包 (Dependencies)
node_modules/
jspm_packages/

# 2. 环境配置文件 (Environment variables)
# 必须排除，防止泄露 API Key、数据库密码等敏感信息
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. 编译产物 (Build output)
# 如果你使用 tsc 编译成 JS
dist/
build/
out/
*.tsbuildinfo

# 4. 日志文件 (Logs)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 5. 运行时文件 (Runtime)
pids
*.pid
*.seed
*.pid.lock

# 6. 编辑器及系统相关 (Editor & OS)
.vscode/
.idea/
.DS_Store
Thumbs.db

# 7. 测试/覆盖率报告 (Coverage)
coverage/
.nyc_output

# 8. 数据库相关 (如果是本地 SQLite 或缓存)
*.db
*.sqlite
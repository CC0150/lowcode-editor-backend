datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Form {
  id         String   @id @default(cuid()) // 唯一标识
  title      String   @default("未命名表单")
  components Json     // 直接存储 ComponentSchema[] 数组
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}